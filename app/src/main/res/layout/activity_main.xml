<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <EditText
        android:id="@+id/etGameName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Game Name"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvSelectedInstaller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No installer selected"
        android:textColor="#FFFFFF"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnSelectGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add to Home Screen Shortcut"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnInstallGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Install Game Automatically"/>

</LinearLayout>
